{
  "name": "ManagedSitesDevelopment",
  "displayName": "Managed Sites development site",
  "description": "A site to investigate Managed Sites against: three managed sites on URL prefixes, three editors cleared for them, and content scoped so each kind of composition has something to override.",
  "author": "VendallionCMS Team",
  "website": "https://vendallioncms.example",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "development" ],
  "tags": [ "managedsites", "development" ],

  "variables": {
    "homeId": "[js:uuid()]"
  },

  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.HomeRoute",
        "OrchardCore.Admin",
        "OrchardCore.Diagnostics",
        "OrchardCore.Features",
        "OrchardCore.Navigation",
        "OrchardCore.Recipes",
        "OrchardCore.Resources",
        "OrchardCore.Roles",
        "OrchardCore.Settings",
        "OrchardCore.Themes",
        "OrchardCore.Users",

        "OrchardCore.Alias",
        "OrchardCore.Autoroute",
        "OrchardCore.ContentFields",
        "OrchardCore.Contents",
        "OrchardCore.ContentTypes",
        "OrchardCore.Flows",
        "OrchardCore.Html",
        "OrchardCore.Layers",
        "OrchardCore.Liquid",
        "OrchardCore.Media",
        // Without this, media permissions are tenant-wide and every grant below is meaningless.
        "OrchardCore.Media.Security",
        "OrchardCore.Menu",
        "OrchardCore.Title",
        "OrchardCore.Widgets",

        "VendallionCMS.ManagedSites",

        "TheAdmin",
        "TheTheme"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": "TheTheme"
    },
    {
      // Everything a managed site editor needs and nothing more. Notably not ManageManagedSites:
      // an editor who could govern managed sites could put more content in scope and clear
      // themselves for it, which is the line this feature's permissions draw.
      "name": "Roles",
      "Roles": [
        {
          "Name": "Managed Site Content Editor",
          "Description": "Opens the managed site content screens and the media library.",
          // The gate, held by every editor: it opens the screens the way ManageMedia opens the media
          // library. Which managed sites are behind it comes from the roles below. ViewMediaContent_shared
          // is the one blueprint folder every managed site may reuse, for reading only.
          "Permissions": [ "EditManagedSiteContent", "AccessAdminPanel", "ManageOwnMediaContent", "ViewMediaContent_shared" ]
        },
        // One role per managed site, holding that site's content and that site's folder together. This
        // is the whole point of generating a permission per managed site: a single grant covers both,
        // and an editor of two sites holds two of these rather than being tracked in two systems.
        {
          "Name": "Alpha Editors",
          "Description": "Works on Alpha.",
          "Permissions": [ "EditManagedSiteContent_alpha", "PublishManagedSiteContent_alpha", "PreviewManagedSiteContent_alpha", "ViewMediaContent_alpha" ]
        },
        {
          "Name": "Beta Editors",
          "Description": "Works on Beta.",
          "Permissions": [ "EditManagedSiteContent_beta", "PublishManagedSiteContent_beta", "PreviewManagedSiteContent_beta", "ViewMediaContent_beta" ]
        },
        {
          "Name": "Gamma Editors",
          "Description": "Works on Gamma.",
          "Permissions": [ "EditManagedSiteContent_gamma", "PublishManagedSiteContent_gamma", "PreviewManagedSiteContent_gamma", "ViewMediaContent_gamma" ]
        },
        // Reading and nothing else. Viewing is the floor every other authority implies, so a role can
        // hold it alone to let somebody look at a managed site without changing it.
        {
          "Name": "Gamma Readers",
          "Description": "Reads Gamma without changing it.",
          "Permissions": [ "ViewManagedSiteContent_gamma", "ViewMediaContent_gamma" ]
        }
      ]
    },
    {
      "name": "ContentDefinition",
      "ContentTypes": [
        {
          "Name": "Section",
          "DisplayName": "Section",
          "Settings": { "ContentTypeSettings": { "Creatable": false, "Securable": false } },
          "ContentTypePartDefinitionRecords": [
            { "PartName": "TitlePart", "Name": "TitlePart", "Settings": {} },
            { "PartName": "HtmlBodyPart", "Name": "HtmlBodyPart", "Settings": {} },
            {
              // The common case: a section lives inside its page rather than in its own right.
              "PartName": "ManagedContentPart",
              "Name": "ManagedContentPart",
              "Settings": {}
            }
          ]
        },
        {
          "Name": "Page",
          "DisplayName": "Page",
          "Settings": {
            "ContentTypeSettings": { "Creatable": true, "Listable": true, "Draftable": true, "Versionable": true, "Securable": true }
          },
          "ContentTypePartDefinitionRecords": [
            { "PartName": "TitlePart", "Name": "TitlePart", "Settings": {} },
            { "PartName": "AutoroutePart", "Name": "AutoroutePart", "Settings": { "AutoroutePartSettings": { "Pattern": "{{ Model.ContentItem | display_text | slugify }}" } } },
            // Rendered in full rather than as summaries. A summary links its title to the contained
            // item's own address, and a section has none -- it is stored inside its page -- so the
            // stock summary gave every section a heading that led to a 404.
            { "PartName": "BagPart", "Name": "Sections", "Settings": { "BagPartSettings": { "ContainedContentTypes": [ "Section" ], "DisplayType": "Detail" } } },
            {
              // A page is stored in its own right, so overriding one replaces the whole page,
              // sections included.
              "PartName": "ManagedContentPart",
              "Name": "ManagedContentPart",
              "Settings": {}
            }
          ]
        },
        {
          "Name": "LinkMenuItem",
          "ContentTypePartDefinitionRecords": [
            {
              // A menu entry is nested in its menu and has no document of its own.
              "PartName": "ManagedContentPart",
              "Name": "ManagedContentPart",
              "Settings": {}
            }
          ]
        },
        {
          "Name": "RawHtml",
          "ContentTypePartDefinitionRecords": [
            {
              // A layer widget is drawn on every page, so overriding one changes a managed site
              // everywhere at once.
              "PartName": "ManagedContentPart",
              "Name": "ManagedContentPart",
              "Settings": {}
            }
          ]
        }
      ],
      "ContentParts": [
        { "Name": "Section", "Settings": { "ContentPartSettings": { "Attachable": false } } }
      ]
    },
    {
      "name": "ManagedSites",
      "ManagedSites": [
        {
          // Prefixes rather than host names on purpose: no host file entries, no certificates, no
          // second sign-in, and draft preview works through them, which it cannot across hosts.
          "Code": "alpha",
          "Name": "Alpha",
          "UrlPrefix": "alpha",
          "Status": "Enabled"
        },
        {
          "Code": "beta",
          "Name": "Beta",
          "UrlPrefix": "beta",
          "Status": "Enabled"
        },
        {
          "Code": "gamma",
          "Name": "Gamma",
          "UrlPrefix": "gamma",
          "Status": "Enabled"
        }
      ]
    },
    {
      "name": "ManagedSiteEditors",
      "Editors": [
        {
          "UserName": "alphaUser",
          "Password": "Password1!",
          "RoleNames": [ "Managed Site Content Editor", "Alpha Editors" ]
        },
        {
          // Authorized for two managed sites, so the screen that offers the choice is reachable
          // without editing anybody first. Gamma is read-only for them, which is what holding the
          // reading role and not the editing one means.
          "UserName": "betaUser",
          "Password": "Password1!",
          "RoleNames": [ "Managed Site Content Editor", "Beta Editors", "Gamma Readers" ]
        },
        {
          "UserName": "gammaUser",
          "Password": "Password1!",
          "RoleNames": [ "Managed Site Content Editor", "Gamma Editors" ]
        },
        {
          // The screens and no managed site behind them, which is what somebody looks like before
          // anybody gives them a site to work on.
          "UserName": "strandedUser",
          "Password": "Password1!",
          "RoleNames": [ "Managed Site Content Editor" ]
        }
      ]
    },
    {
      // Assets to try the folder rules against. The managed sites' own folders are made when the sites
      // are defined, a step above; these put something in each so there is something to see and move.
      "name": "media",
      "Files": [
        {
          // The Site Blueprint's shared folder. Every editor is granted it for reading, and no editor
          // can write to it, which is the pair of rules worth seeing work.
          "TargetPath": "shared/blueprint-mark.png",
          "Base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
        },
        {
          // A blueprint folder nobody is granted. It should not appear for an editor at all.
          "TargetPath": "restricted/not-for-sites.png",
          "Base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
        },
        { "TargetPath": "alpha/alpha-mark.png", "Base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==" },
        { "TargetPath": "beta/beta-mark.png", "Base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==" },
        { "TargetPath": "gamma/gamma-mark.png", "Base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==" }
      ]
    },
    {
      "name": "content",
      "data": [
        {
          "ContentItemId": "[js:variables('homeId')]",
          "ContentItemVersionId": "[js:uuid()]",
          "ContentType": "Page",
          "DisplayText": "Home",
          "Latest": true,
          "Published": true,
          "TitlePart": { "Title": "Home" },
          "AutoroutePart": { "Path": "home", "SetHomepage": true },
          "ManagedContentPart": {
            // Open to every managed site: overriding this replaces the whole page, its sections
            // included, which is worth seeing once.
            "EditScope": { "Mode": "All", "ManagedSiteCodes": [] },
            "DisplayScope": { "Mode": "All", "ManagedSiteCodes": [] },
            "DisplayInBlueprintContext": true
          },
          "Sections": {
            "ContentItems": [
              {
                "ContentItemId": "[js:uuid()]",
                "ContentItemVersionId": "[js:uuid()]",
                "ContentType": "Section",
                "DisplayText": "What we do",
                "Latest": true,
                "Published": true,
                "TitlePart": { "Title": "What we do" },
                "HtmlBodyPart": { "Html": "<p>The Site Blueprint's words. Every managed site may replace this one.</p>" },
                "ManagedContentPart": {
                  "EditScope": { "Mode": "All", "ManagedSiteCodes": [] },
                  "DisplayScope": { "Mode": "All", "ManagedSiteCodes": [] },
                  "DisplayInBlueprintContext": true
                }
              },
              {
                "ContentItemId": "[js:uuid()]",
                "ContentItemVersionId": "[js:uuid()]",
                "ContentType": "Section",
                "DisplayText": "Where we are",
                "Latest": true,
                "Published": true,
                "TitlePart": { "Title": "Where we are" },
                "HtmlBodyPart": { "Html": "<p>Only Alpha may replace this one, so Beta and Gamma will not see it in their content list.</p>" },
                "ManagedContentPart": {
                  "EditScope": { "Mode": "Selected", "ManagedSiteCodes": [ "alpha" ] },
                  "DisplayScope": { "Mode": "All", "ManagedSiteCodes": [] },
                  "DisplayInBlueprintContext": true
                }
              },
              {
                "ContentItemId": "[js:uuid()]",
                "ContentItemVersionId": "[js:uuid()]",
                "ContentType": "Section",
                "DisplayText": "Not for anybody",
                "Latest": true,
                "Published": true,
                "TitlePart": { "Title": "Not for anybody" },
                "HtmlBodyPart": { "Html": "<p>Nobody may replace this one. It is here so the content list has something it does not offer, which is the first question it raises.</p>" },
                "ManagedContentPart": {
                  "EditScope": { "Mode": "None", "ManagedSiteCodes": [] },
                  "DisplayScope": { "Mode": "All", "ManagedSiteCodes": [] },
                  "DisplayInBlueprintContext": true
                }
              }
            ]
          }
        },
        {
          "ContentItemId": "[js:uuid()]",
          "ContentItemVersionId": "[js:uuid()]",
          "ContentType": "Page",
          "DisplayText": "About",
          "Latest": true,
          "Published": true,
          "TitlePart": { "Title": "About" },
          "AutoroutePart": { "Path": "about" },
          "ManagedContentPart": {
            // A second page, so the navigation leads somewhere and there is more than one page to
            // compare a managed site's version against.
            "EditScope": { "Mode": "All", "ManagedSiteCodes": [] },
            "DisplayScope": { "Mode": "All", "ManagedSiteCodes": [] },
            "DisplayInBlueprintContext": true
          },
          "Sections": {
            "ContentItems": [
              {
                "ContentItemId": "[js:uuid()]",
                "ContentItemVersionId": "[js:uuid()]",
                "ContentType": "Section",
                "DisplayText": "Who we are",
                "Latest": true,
                "Published": true,
                "TitlePart": { "Title": "Who we are" },
                "HtmlBodyPart": { "Html": "<p>The same words on every managed site, until one of them says otherwise.</p>" },
                "ManagedContentPart": {
                  "EditScope": { "Mode": "All", "ManagedSiteCodes": [] },
                  "DisplayScope": { "Mode": "All", "ManagedSiteCodes": [] },
                  "DisplayInBlueprintContext": true
                }
              }
            ]
          }
        },
        {
          "ContentItemId": "[js:uuid()]",
          "ContentItemVersionId": "[js:uuid()]",
          "ContentType": "Menu",
          "DisplayText": "Main Menu",
          "Latest": true,
          "Published": true,
          "TitlePart": { "Title": "Main Menu" },
          "AliasPart": { "Alias": "main-menu" },
          "ManagedContentPart": {
            "EditScope": { "Mode": "All", "ManagedSiteCodes": [] },
            "DisplayScope": { "Mode": "All", "ManagedSiteCodes": [] },
            "DisplayInBlueprintContext": true
          },
          "MenuItemsListPart": {
            "MenuItems": [
              {
                "ContentItemId": "[js:uuid()]",
                "ContentType": "LinkMenuItem",
                "DisplayText": "Home",
                "LinkMenuItemPart": { "Name": "Home", "Url": "~/" },
                "ManagedContentPart": {
                  // An entry nested in a menu: overriding this changes one link for one managed
                  // site, leaving the rest of the navigation alone.
                  "EditScope": { "Mode": "All", "ManagedSiteCodes": [] },
                  "DisplayScope": { "Mode": "All", "ManagedSiteCodes": [] },
                  "DisplayInBlueprintContext": true
                }
              },
              {
                "ContentItemId": "[js:uuid()]",
                "ContentType": "LinkMenuItem",
                "DisplayText": "About",
                "LinkMenuItemPart": { "Name": "About", "Url": "~/about" },
                "ManagedContentPart": {
                  "EditScope": { "Mode": "None", "ManagedSiteCodes": [] },
                  "DisplayScope": { "Mode": "All", "ManagedSiteCodes": [] },
                  "DisplayInBlueprintContext": true
                }
              }
            ]
          }
        },
        {
          "ContentItemId": "[js:uuid()]",
          "ContentItemVersionId": "[js:uuid()]",
          "ContentType": "RawHtml",
          "DisplayText": "Footer note",
          "Latest": true,
          "Published": true,
          "RawHtml": { "Content": { "Html": "<p>The Site Blueprint's footer, drawn on every page by a layer.</p>" } },
          "LayerMetadata": { "Layer": "Always", "Zone": "Footer", "Position": "1", "RenderTitle": false },
          "ManagedContentPart": {
            "EditScope": { "Mode": "All", "ManagedSiteCodes": [] },
            "DisplayScope": { "Mode": "All", "ManagedSiteCodes": [] },
            "DisplayInBlueprintContext": true
          }
        }
      ]
    },
    {
      "name": "layers",
      "Layers": [
        {
          "Name": "Always",
          "Rule": "true",
          "Description": "The widgets in this layer are displayed on any page of this site."
        }
      ]
    },
    {
      "name": "settings",
      "HomeRoute": {
        "Action": "Display",
        "Controller": "Item",
        "Area": "OrchardCore.Contents",
        "ContentItemId": "[js:variables('homeId')]"
      }
    }
  ]
}
