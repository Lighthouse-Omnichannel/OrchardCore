@model VendallionCMS.ManagedSites.ViewModels.ManagedSiteContentSuppressedViewModel

<zone Name="Title">
    <h1>@T["Not rendering"] <small class="text-muted">@Model.ManagedSite.Name</small></h1>
</zone>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <p class="hint">@T["Versions of your own that exist but are not being served. Each is kept, and starts being served again if the reason is undone."]</p>
    </div>
</div>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info" role="status">@T["Everything you have customized is being served."]</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">@T["Item"]</th>
                    <th scope="col">@T["Why it stopped"]</th>
                    <th scope="col"><span class="visually-hidden">@T["Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.SourceContentItemId</td>
                        <td><span class="badge bg-warning text-dark">@item.SuppressionReason</span></td>
                        <td class="text-end">
                            <div class="actions">
                                <a class="btn btn-sm btn-primary edit"
                                   asp-action="Edit" asp-controller="Admin" asp-area="OrchardCore.Contents"
                                   asp-route-contentItemId="@item.OverrideContentItemId"
                                   asp-route-returnUrl="@FullRequestPath"
                                   aria-label="@T["Edit your version of {0}", item.SourceContentItemId]"><span>@T["Edit"]</span></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Under what it acts on, where the admin puts the way out of a screen. *@
<div class="ocat-wrapper mt-3">
    <div class="ocat-end-offset">
        <a class="btn btn-secondary" role="button" asp-action="Index" asp-route-managedSiteCode="@Model.ManagedSite.Code">@T["Back"]</a>
    </div>
</div>
