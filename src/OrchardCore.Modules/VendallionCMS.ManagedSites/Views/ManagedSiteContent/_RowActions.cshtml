@model VendallionCMS.ManagedSites.ViewModels.ManagedContentRowActionsViewModel
@{
    var item = Model.Item;
    var hasOverride = item.Override is not null;

    // What goes behind the Actions menu rather than on the row, which is the admin's own division:
    // what an editor reaches for is a button, what they do occasionally or cannot undo is a menu item.
    var canPublish = hasOverride && item.Override.Status != "Published" && Model.CanPublish;
    var canRemove = hasOverride && Model.CanEdit;
}

@* Laid out as a content item's row is: the primary action as a button, the rest behind Actions. The
   admin turns an UnsafeUrl anchor into a posted form with an antiforgery token, so an action that
   changes something is still a POST without a form of its own on every row. *@
<div class="actions">
    @if (hasOverride)
    {
        <a class="btn btn-sm btn-primary edit"
           asp-action="Edit" asp-controller="Admin" asp-area="OrchardCore.Contents"
           asp-route-contentItemId="@item.Override.OverrideContentItemId"
           asp-route-returnUrl="@Model.ReturnUrl"
           aria-label="@T["Edit your version of {0}", item.DisplayText]"><span>@T["Edit"]</span></a>
    }
    else if (Model.CanEdit)
    {
        @* Creates the version and opens it. The copy an editor is handed is the blueprint content
           until they change it, so the point of creating one is to start. *@
        <a class="btn btn-sm btn-primary create"
           asp-action="Create" asp-route-managedSiteCode="@Model.ManagedSiteCode"
           asp-route-sourceContentItemId="@item.SourceContentItemId"
           asp-route-returnUrl="@Model.ReturnUrl"
           data-url-af="UnsafeUrl"
           aria-label="@T["Create your version of {0} and edit it", item.DisplayText]"><span>@T["Create your version"]</span></a>
    }

    @if (item.ContainedItemCount > 0)
    {
        <a class="btn btn-sm btn-secondary"
           asp-action="Contained" asp-route-managedSiteCode="@Model.ManagedSiteCode"
           asp-route-sourceContentItemId="@item.SourceContentItemId"
           aria-label="@T["List what is inside {0}", item.DisplayText]"><span>@T["What is inside"]</span></a>
    }

    @if (canPublish || canRemove)
    {
        <div class="btn-group" title="@T["Actions"]">
            <button type="button" class="btn btn-sm btn-secondary dropdown-toggle actions" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <span>@T["Actions"]</span>
            </button>
            <div class="actions-menu dropdown-menu dropdown-menu-end">
                @if (canPublish)
                {
                    <a class="dropdown-item btn-sm"
                       asp-action="Publish" asp-route-managedSiteCode="@Model.ManagedSiteCode"
                       asp-route-sourceContentItemId="@item.SourceContentItemId"
                       asp-route-overrideContentItemId="@item.Override.OverrideContentItemId"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       data-url-af="UnsafeUrl">@T["Publish your version"]</a>
                }

                @if (canPublish && canRemove)
                {
                    <div class="dropdown-divider"></div>
                }

                @if (canRemove)
                {
                    <a class="dropdown-item btn-sm"
                       asp-action="Remove" asp-route-managedSiteCode="@Model.ManagedSiteCode"
                       asp-route-sourceContentItemId="@item.SourceContentItemId"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       data-url-af="UnsafeUrl RemoveUrl"
                       data-title="@T["Remove your version"]"
                       data-message="@T["This managed site goes back to the blueprint content of {0}. Are you sure?", item.DisplayText]"
                       data-ok-text="@T["Ok"]"
                       data-cancel-text="@T["Cancel"]">@T["Remove your version"]</a>
                }
            </div>
        </div>
    }
</div>
