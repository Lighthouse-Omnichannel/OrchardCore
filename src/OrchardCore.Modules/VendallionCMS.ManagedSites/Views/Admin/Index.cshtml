@using VendallionCMS.ManagedSites.Models
@using VendallionCMS.ManagedSites.Services
@using VendallionCMS.ManagedSites.ViewModels
@model ManagedSiteIndexViewModel

<zone Name="Title"><h1>@RenderTitleSegments(T["Managed Sites"])</h1></zone>

@* Read as the content list is read: a bar that sticks and holds what creates, a header row that counts
   what is below it, one row a managed site, and what can be done to it on the row it is on. *@
<div class="card text-bg-theme mb-3 position-sticky action-bar">
    <div class="card-body">
        <div class="row gx-3">
            <div class="col d-flex align-items-center">
                <span class="hint mb-0">@T["Managed Sites are address-scoped content contexts inside this site, addressed by host name and URL prefix the way a tenant is."]</span>
            </div>
            <div class="col-auto">
                <a asp-action="Create" class="btn btn-secondary create">@T["Add managed site"]</a>
            </div>
        </div>
    </div>
</div>

<ul class="list-group">
    <li class="list-group-item text-bg-theme">
        <div class="row gx-3">
            <div class="col">
                <span class="text-nowrap">@T.Plural(Model.ManagedSites.Count, "{0} managed site", "{0} managed sites")</span>
            </div>
        </div>
    </li>

    @if (Model.ManagedSites.Count > 0)
    {
        @foreach (var managedSite in Model.ManagedSites)
        {
            @* Where the managed site answers. A host name wins outright, exactly as it does when a
               request is resolved, so a site naming one is reached there and its prefix is not
               consulted. A site naming neither answers on the tenant's own address, which is not its
               own address to link to. *@
            var host = ManagedSiteAddressValidator.SplitHostnames(managedSite.Hostname).FirstOrDefault();

            var address = !string.IsNullOrEmpty(host)
                ? $"{Context.Request.Scheme}://{host}"
                : string.IsNullOrEmpty(managedSite.UrlPrefix)
                    ? null
                    : $"~/{managedSite.UrlPrefix}";

            <li class="list-group-item list-group-item-action">
                <div class="row">
                    <div class="col-lg col-12 title d-flex align-items-center">
                        <div class="summary d-flex flex-column flex-md-row">
                            <div class="contentitem me-2">
                                @if (address is null)
                                {
                                    @managedSite.Name
                                }
                                else
                                {
                                    <a href="@Url.Content(address)" target="_blank" rel="noopener"
                                       aria-label="@T["Open {0}", managedSite.Name]">@managedSite.Name</a>
                                }
                            </div>
                            <div class="metadata me-1">
                                @if (managedSite.Status == ManagedSiteStatus.Enabled)
                                {
                                    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]">
                                        <i class="fa-solid fa-check text-success" aria-hidden="true"></i> @T["Enabled"]
                                    </span>
                                }
                                else
                                {
                                    <span class="badge ta-badge fw-normal text-muted" data-bs-toggle="tooltip"
                                          title="@T["A disabled managed site resolves no requests and accepts no editor changes."]">
                                        <i class="fa-regular fa-circle" aria-hidden="true"></i> @T["Disabled"]
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-auto col-12 d-flex justify-content-end">
                        <div class="actions">
                            <a asp-action="Edit" asp-route-code="@managedSite.Code" class="btn btn-sm btn-primary edit"><span>@T["Edit"]</span></a>

                            <a asp-action="Access" asp-route-code="@managedSite.Code" class="btn btn-sm btn-secondary"
                               aria-label="@T["Choose who can work on {0}", managedSite.Name]">
                                <i class="fa-solid fa-user-lock" aria-hidden="true"></i> <span>@T["Access"]</span>
                            </a>

                            <div class="btn-group" title="@T["Actions"]">
                                <button type="button" class="btn btn-sm btn-secondary dropdown-toggle actions" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <span>@T["Actions"]</span>
                                </button>
                                <div class="actions-menu dropdown-menu dropdown-menu-end">
                                    @* RemoveUrl raises the admin confirmation modal; UnsafeUrl posts it with an antiforgery token. *@
                                    <a asp-action="Delete" asp-route-code="@managedSite.Code" class="dropdown-item btn-sm"
                                       data-url-af="UnsafeUrl RemoveUrl"
                                       data-title="@T["Delete managed site"]"
                                       data-message="@T["Are you sure you want to delete this managed site? Its host names are withdrawn from this site."]"
                                       data-ok-text="@T["Ok"]"
                                       data-cancel-text="@T["Cancel"]">@T["Delete"]</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </li>
        }
    }
    else
    {
        <li class="list-group-item">
            <div class="alert alert-info mb-0" role="alert">
                @T["No managed sites have been defined yet."]
            </div>
        </li>
    }
</ul>
