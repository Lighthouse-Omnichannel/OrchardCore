@using VendallionCMS.ManagedSites.Services
@using VendallionCMS.ManagedSites.ViewModels
@model ManagedSiteIndexViewModel

<zone Name="Title"><h1>@T["Managed Sites"]</h1></zone>

<div class="mb-3">
    <p class="text-muted">@T["Managed Sites are address-scoped content contexts inside this site, addressed by host name and URL prefix the way a tenant is."]</p>
    <a asp-action="Create" class="btn btn-primary create">@T["Add managed site"]</a>
</div>

@if (Model.ManagedSites.Count == 0)
{
    <div class="alert alert-info" role="alert">
        @T["No managed sites have been defined yet."]
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">@T["Name"]</th>
                    <th scope="col">@T["Status"]</th>
                    <th scope="col" class="text-end">@T["Actions"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var managedSite in Model.ManagedSites)
            {
                <tr>
                    @{
                        @* Where the managed site answers. A host name wins outright, exactly as it does
                           when a request is resolved, so a site naming one is reached there and its
                           prefix is not consulted. A site naming neither answers on the tenant's own
                           address, which is not its own address to link to. *@
                        var host = ManagedSiteAddressValidator.SplitHostnames(managedSite.Hostname).FirstOrDefault();

                        var address = !string.IsNullOrEmpty(host)
                            ? $"{Context.Request.Scheme}://{host}"
                            : string.IsNullOrEmpty(managedSite.UrlPrefix)
                                ? null
                                : $"~/{managedSite.UrlPrefix}";
                    }
                    <td>
                        @if (address is null)
                        {
                            @managedSite.Name
                        }
                        else
                        {
                            <a href="@Url.Content(address)" target="_blank" rel="noopener"
                               aria-label="@T["Open {0}", managedSite.Name]">@managedSite.Name</a>
                        }
                    </td>
                    <td>@managedSite.Status</td>
                    <td class="text-end">
                        <a asp-action="Security" asp-route-code="@managedSite.Code" class="btn btn-sm btn-secondary"
                           aria-label="@T["Choose who can work on {0}", managedSite.Name]">
                            <i class="fa-solid fa-user-lock" aria-hidden="true"></i> @T["Access"]
                        </a>
                        <a asp-action="Edit" asp-route-code="@managedSite.Code" class="btn btn-sm btn-secondary">@T["Edit"]</a>
                        @* RemoveUrl raises the admin confirmation modal; UnsafeUrl posts it with an antiforgery token. *@
                        <a asp-action="Delete" asp-route-code="@managedSite.Code" class="btn btn-sm btn-danger"
                           data-url-af="RemoveUrl UnsafeUrl"
                           data-title="@T["Delete managed site"]"
                           data-message="@T["Are you sure you want to delete this managed site? Its host names are withdrawn from this site."]">@T["Delete"]</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
