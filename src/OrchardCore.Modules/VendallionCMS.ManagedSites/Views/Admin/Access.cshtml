@using VendallionCMS.ManagedSites
@model VendallionCMS.ManagedSites.ViewModels.ManagedSiteAccessViewModel

<zone Name="Title">
    <h1>@RenderTitleSegments(T["Who can work on {0}", Model.ManagedSite.Name])</h1>
</zone>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <p class="hint">@T["Clearance is granted here, on the managed site it covers. A user granted one can open this site's content and read it, and no other site's unless they are granted that too. What they may do beyond reading is ticked on their row."]</p>
    </div>
</div>

<div class="row g-3">
    @* Two lists rather than one: who may work on this site, and who could. Searching either one is how
       a tenant with more users than fit on a screen is worked through. *@
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <strong>@T["Users without access"]</strong>
            </div>
            <div class="card-body">
                <form asp-action="Access" asp-route-code="@Model.ManagedSite.Code" method="get" class="mb-3">
                    <input type="hidden" name="cleared" value="@Model.ClearedSearch" />
                    <div class="input-group">
                        <label for="available" class="visually-hidden">@T["Search users without access"]</label>
                        <input type="search" id="available" name="available" value="@Model.AvailableSearch"
                               class="form-control" placeholder="@T["Search by name or email"]" />
                        <button type="submit" class="btn btn-secondary">@T["Search"]</button>
                    </div>
                </form>

                @if (Model.Available.Count == 0)
                {
                    <p class="text-muted mb-0">
                        @(string.IsNullOrEmpty(Model.AvailableSearch)
                            ? T["Every user already has access to this managed site."]
                            : T["No user without access matches that."])
                    </p>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var user in Model.Available)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <span>
                                    @user.UserName
                                    @if (!string.IsNullOrEmpty(user.Email))
                                    {
                                        <span class="hint d-block">@user.Email</span>
                                    }
                                </span>
                                <form asp-action="Grant" asp-route-code="@Model.ManagedSite.Code" method="post">
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    <input type="hidden" name="available" value="@Model.AvailableSearch" />
                                    <input type="hidden" name="cleared" value="@Model.ClearedSearch" />
                                    <button type="submit" class="btn btn-primary btn-sm"
                                            aria-label="@T["Give {0} access to this managed site", user.UserName]">
                                        @T["Give access"]
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>

                    @if (Model.MoreAvailable)
                    {
                        <p class="hint mt-2 mb-0">@T["More users match than are shown. Search to narrow the list."]</p>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <strong>@T["Users with access"]</strong>
            </div>
            <div class="card-body">
                <form asp-action="Access" asp-route-code="@Model.ManagedSite.Code" method="get" class="mb-3">
                    <input type="hidden" name="available" value="@Model.AvailableSearch" />
                    <div class="input-group">
                        <label for="cleared" class="visually-hidden">@T["Search users with access"]</label>
                        <input type="search" id="cleared" name="cleared" value="@Model.ClearedSearch"
                               class="form-control" placeholder="@T["Search by name or email"]" />
                        <button type="submit" class="btn btn-secondary">@T["Search"]</button>
                    </div>
                </form>

                @if (Model.Cleared.Count == 0)
                {
                    <p class="text-muted mb-0">
                        @(string.IsNullOrEmpty(Model.ClearedSearch)
                            ? T["Nobody can work on this managed site yet."]
                            : T["No user with access matches that."])
                    </p>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var user in Model.Cleared)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <span>
                                        @user.UserName
                                        @if (!string.IsNullOrEmpty(user.Email))
                                        {
                                            <span class="hint d-block">@user.Email</span>
                                        }
                                    </span>
                                    <form asp-action="Revoke" asp-route-code="@Model.ManagedSite.Code" method="post">
                                        <input type="hidden" name="userId" value="@user.UserId" />
                                        <input type="hidden" name="available" value="@Model.AvailableSearch" />
                                        <input type="hidden" name="cleared" value="@Model.ClearedSearch" />
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                data-url-af="RemoveUrl"
                                                data-title="@T["Take away access"]"
                                                data-message="@T["{0} will no longer be able to work on {1}. Are you sure?", user.UserName, Model.ManagedSite.Name]"
                                                aria-label="@T["Take {0}'s access to this managed site away", user.UserName]">
                                            @T["Take away"]
                                        </button>
                                    </form>
                                </div>

                                @* Reading is not among them: holding the clearance is what allows that.
                                   Every box clear means the holder may read this managed site and do
                                   nothing else to it. *@
                                <form asp-action="Scopes" asp-route-code="@Model.ManagedSite.Code" method="post"
                                      class="d-flex flex-wrap align-items-center gap-3 mt-2">
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    <input type="hidden" name="available" value="@Model.AvailableSearch" />
                                    <input type="hidden" name="cleared" value="@Model.ClearedSearch" />

                                    <span class="hint me-1">@T["May also"]</span>

                                    @foreach (var scope in ManagedSitesConstants.Scopes.All)
                                    {
                                        var inputId = $"{user.UserId}-{scope}";
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="scopes"
                                                   id="@inputId" value="@scope"
                                                   checked="@user.Scopes.Contains(scope, StringComparer.Ordinal)" />
                                            <label class="form-check-label" for="@inputId">@scope</label>
                                        </div>
                                    }

                                    <button type="submit" class="btn btn-secondary btn-sm"
                                            aria-label="@T["Change what {0} may do on this managed site", user.UserName]">
                                        @T["Apply"]
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<div class="ocat-wrapper mt-3">
    <div class="ocat-end-offset">
        <a class="btn btn-secondary" role="button" asp-action="Index">@T["Back"]</a>
    </div>
</div>
